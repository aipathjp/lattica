{
  "name": "@ai-path/tb-formula",
  "version": "0.3.0",
  "description": "Clean-room, dependency-free Excel-compatible formula engine for Taible: lexer, Pratt parser, evaluator, and an incremental dependency graph.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-path/tb-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aipathjp/taible.git",
    "directory": "packages/formula"
  },
  "homepage": "https://github.com/aipathjp/taible#readme",
  "bugs": {
    "url": "https://github.com/aipathjp/taible/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

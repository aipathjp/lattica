{
  "name": "@ai-path/tb-mcp",
  "version": "0.2.0",
  "description": "Expose a Taible grid to AI agents: a transport-agnostic tool registry (get_cell/set_cell/get_range/evaluate/define_name) with handler-validated inputs and a result-enveloped dispatcher.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "scripts": { "build": "tsup", "typecheck": "tsc --noEmit" },
  "dependencies": { "@ai-path/tb-formula": "workspace:*" },
  "publishConfig": { "access": "public", "provenance": true },
  "repository": { "type": "git", "url": "https://github.com/aipathjp/lattica.git", "directory": "packages/mcp" },
  "homepage": "https://github.com/aipathjp/lattica#readme",
  "bugs": { "url": "https://github.com/aipathjp/lattica/issues" }
}

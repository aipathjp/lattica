{
  "name": "@ai-path/tb-io",
  "version": "0.3.0",
  "description": "Import/export for Taible: CSV/TSV parsing & serialization, clipboard (TSV + HTML) interop, and dependency-free XLSX (OOXML) export.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-path/tb-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aipathjp/taible.git",
    "directory": "packages/io"
  },
  "homepage": "https://github.com/aipathjp/taible#readme",
  "bugs": {
    "url": "https://github.com/aipathjp/taible/issues"
  }
}

{
  "name": "@ai-path/tb-core",
  "version": "0.3.0",
  "description": "Framework-agnostic core engine for the Taible data grid: data model, coordinate system, selection, virtualization math, command/undo-redo.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aipathjp/lattica.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aipathjp/lattica#readme",
  "bugs": {
    "url": "https://github.com/aipathjp/lattica/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@ai-path/tb-data",
  "version": "0.3.0",
  "description": "Index mapping (physical<->visual) and data-source binding for Taible: the foundation for hiding, moving, sorting, filtering, trimming, and grouping.",
  "homepage": "https://github.com/aipathjp/lattica#readme",
  "bugs": {
    "url": "https://github.com/aipathjp/lattica/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aipathjp/lattica.git",
    "directory": "packages/data"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-path/tb-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

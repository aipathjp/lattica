{
  "name": "@ai-path/tb-react",
  "version": "0.4.1",
  "description": "React bindings for Taible: a canvas-rendered, virtualized data grid with DOM editing overlay, multi-level grouping headers, and IME-aware editing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aipathjp/taible.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/aipathjp/taible#readme",
  "bugs": {
    "url": "https://github.com/aipathjp/taible/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-path/tb-core": "workspace:*",
    "@ai-path/tb-data": "workspace:*",
    "@ai-path/tb-formula": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
